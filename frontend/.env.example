# Base URL of the FastAPI backend (no trailing slash, no /api/v1 — that
# prefix is added in src/config/api.ts)
VITE_API_BASE_URL=http://localhost:8000

# false (default): use the real backend. true: use the in-memory mock
# service layer under src/services/mock/ for frontend-only development.
# There is no automatic fallback from real to mock on failure — a backend
# error surfaces as an error state, never fake data.
VITE_USE_MOCK=false
