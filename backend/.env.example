# --- Application ---
APP_NAME=Health Vault
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# Local dev default (docker-compose). Use postgresql+psycopg://user:pass@host:port/db
DATABASE_URL=postgresql+psycopg://healthvault:healthvault@localhost:5432/healthvault

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# --- Storage ---
# STORAGE_PROVIDER = local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# File upload limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.tiff,.bmp

# --- AI / LLM ---
# AI_PROVIDER = openai | rule_based (rule_based needs no API key, useful for dev/demo)
AI_PROVIDER=rule_based
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- OCR ---
# OCR_PROVIDER = tesseract | none
OCR_PROVIDER=tesseract
TESSERACT_CMD=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
